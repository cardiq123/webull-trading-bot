# Copy to .env and fill in. Never commit .env.
# The process reads these from the environment; a local .env is loaded by the CLI if present.

# Official Webull OpenAPI credentials.
# Create them only after the account and API application are approved:
# https://www.webull.com/center#openApiManagement
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_ACCOUNT_ID=
# us | sandbox. Production host api.webull.com; test host api.sandbox.webull.com.
WEBULL_ENV=sandbox
WEBULL_REGION=us

# Optional override of the typed live-trading phrase for non-interactive starts.
# The process still refuses to go live unless config live_trading_enabled is true.
# WEBULL_LIVE_CONFIRM=I UNDERSTAND LIVE TRADING RISK

# Optional webhook (Slack-compatible JSON POST) for fills, stops, and the daily summary.
WEBHOOK_URL=
