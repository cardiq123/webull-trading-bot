# Copy to .env and fill in. Never commit .env.
# The process reads these from the environment; a local .env is loaded by the CLI if present.

# Official Webull OpenAPI credentials.
# Create them only after the account and API application are approved:
# https://www.webull.com/center#openApiManagement
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
# Internal account_id from the account list (about 26 characters).
# Do not put the DEVxxxx account_number here. The trade API returns
# HTTP 403 ACCOUNT_ACCESS_DENIED for the account number. The bot accepts
# either form and maps account_number to account_id.
WEBULL_ACCOUNT_ID=
# Used when WEBULL_ACCOUNT_ID is empty. INDIVIDUAL_MARGIN or INDIVIDUAL_CASH.
WEBULL_ACCOUNT_CLASS=INDIVIDUAL_MARGIN
# sandbox or production. Live refuses to start unless this is production.
# The paper sandbox command always uses the sandbox hosts.
WEBULL_ENV=sandbox
WEBULL_REGION=us
# SDK session token. Default is ~/.webull-openapi-token (not ./conf).
# WEBULL_OPENAPI_TOKEN_DIR=

# Optional override of the typed live-trading phrase for non-interactive starts.
# The process still refuses to go live unless config live_trading_enabled is true.
# WEBULL_LIVE_CONFIRM=I UNDERSTAND LIVE TRADING RISK

# Optional webhook (Slack-compatible JSON POST) for fills, stops, and the daily summary.
WEBHOOK_URL=
